@@ -94,8 +94,14 @@ jobs:
             # Aynan shu commit'ning image'ini ishlatamiz (latest emas) —
             # shunda qaysi versiya ishlayotgani aniq bo'ladi va rollback oson.
             echo "IMAGE=$IMAGE"
+
+            # --no-build muhim: image tortilmasa, compose serverdagi
+            # kontekstdan jimgina o'zi qurib qo'ymasin. Shunda xato yashirinmaydi.
             docker compose pull
-            docker compose up -d --remove-orphans
+            docker compose up -d --remove-orphans --no-build
+
+            # Qaysi image haqiqatan ishlayotgani log'da ko'rinib tursin.
+            docker inspect -f 'Ishlayotgan image: {{.Config.Image}} ({{.Image}})' yuksalish_bot
 
             # Eski, ishlatilmayotgan image'lar diskni yeb qo'ymasin.
             docker image prune -f
diff --git a/Dockerfile b/Dockerfile
index 84ff7f6..d288f3a 100644
--- a/Dockerfile
