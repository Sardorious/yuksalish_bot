# Copy this file to .env and fill in your values

# Get this from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs that should have admin access
# Find your ID by messaging @userinfobot on Telegram
ADMIN_IDS=123456789,987654321

# Group chats are linked per-class inside the bot.
# Admin uses /setgroup command to link each class to its Telegram group.

# Vaqt mintaqasi (ixtiyoriy). Server UTC da ishlasa ham eslatmalar va
# "bugun" hisobi shu mintaqa bo'yicha ketadi. Standart: Asia/Tashkent
TIMEZONE=Asia/Tashkent

# ── Docker ──────────────────────────────────────────────────────────────────
# docker-compose bu qiymatlarni o'zi belgilaydi, qo'lda yozish shart emas.
# Faqat Docker'siz ishga tushirganda va yo'lni o'zgartirmoqchi bo'lsangiz kerak.
# DB_PATH=exercise_bot.db
# LOG_FILE=bot.log
# LOG_LEVEL=INFO
